#define ICON_RADIUS   6
#define ICON_Y_CENTER (STATUS_BAR_H / 2)  // 12
// Order from left to right: WiFi, MQTT, [50 px spacer], BT, CapsLock, …, Contact. The 50 px gap separates "network reachability" indicators (left
