#pragma once

// Personal / per-deployment data. Copy this file to "personal-data.h", fill in the entries below with your real networks and devices, and DO NOT
// commit "personal-data.h" (it is in .gitignore).
//
// Both tables are used at boot only — WiFi defaults are loaded into WiFiMulti, and the device identity tuple is looked up by MAC in
// identifyDevice() to populate g_deviceData (declared in minimessenger.ino, type defined in contacts.h).
//
// Workflow:
//   1. cp personal-data.h.template personal-data.h
//   2. Edit personal-data.h : fill COMPILED_WIFI_DEFAULTS and COMPILED_DEVICE_DATA_ENTRIES
//   3. Flash
//
// A device whose MAC is not in COMPILED_DEVICE_DATA_ENTRIES falls back to a random ID + pseudo "JohnDoe" + namePrefix "UNK" + ST7789 screen
// — useful when prototyping on a fresh ESP without editing this file first. The device still boots and participates in MQTT messaging, but its
// peers will log it as "device #<n>" rather than under a friendly name, and no "<pseudo> connected" banner will be shown on peer devices when
// it joins.
//
// Include order: this file is included from wifi.ino, AFTER both struct types are in scope (DeviceDataEntry comes via contacts.h pulled by
// minimessenger.ino's include; CompiledWifiEntry is defined at the top of wifi.ino just above the include). Don't add #includes here — they
// would either be redundant or, worse, cause a re-definition once personal-data.h is processed twice in a different include order.


// === Per-device identity table ===
// One row per physical device. Fields, in order:
//   mac        : the device's WiFi MAC as an uppercase colon-separated string (e.g. "xx:xx:xx:xx:xx:xx"). What `esp_read_mac(ESP_MAC_WIFI_STA)`
//                returns once WIFI_STA mode is up.
//   deviceId   : small integer ID (1..254), used in MQTT topics (msg/unicast/<id>), admin/live keepalive payloads, and the trailer of every
//                outgoing chat message. Unique per row.
//   pseudo     : human-readable name shown in logs / banners / info-screen ("Alice", "Bob", …). Latin-1 only (no smart punctuation, no em-dash)
//                — see the display charset memo.
//   namePrefix : 3..5-letter prefix combined with deviceId as "<prefix>_NNN" (e.g. "D1M_001", "E32_004"). Used as MQTT client_id, WiFi hostname,
//                and the "ID:" row on /status.
//   screen     : DisplayType — ST7789 (320×240 TFT) or OLEDSHIELD (SSD1306). The latter branch is a stub today; everything renders ST7789.

const DeviceDataEntry COMPILED_DEVICE_DATA_ENTRIES[] = {
    // { "AA:BB:CC:DD:EE:01", 1, "Alice", "D1M", ST7789     },
    // { "AA:BB:CC:DD:EE:02", 2, "Bob",   "D1M", ST7789     },
    // { "AA:BB:CC:DD:EE:03", 3, "Carol", "D1M", OLEDSHIELD },
    // { "AA:BB:CC:DD:EE:04", 4, "Dave",  "E32", ST7789     },
};


// === WiFi compile-time defaults ===
// Up to MAX_WIFI_NETWORKS (5, defined in wifi.ino). Empty list is fine — boot will open the captive portal. SSID dedup: if the same SSID is also
// in NVS, the NVS entry wins (its password may be fresher).

const CompiledWifiEntry COMPILED_WIFI_DEFAULTS[] = {
    // { "MyHomeWiFi",     "homepassword" },
    // { "MyPhoneHotspot", "hotspotpass"  },
    // { "OfficeWiFi",     "officepass"   },
};


